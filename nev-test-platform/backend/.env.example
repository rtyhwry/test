# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=nev_test_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# GitLab Integration
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=your-gitlab-token

# ALM Integration
ALM_URL=https://alm.example.com
ALM_USERNAME=your-username
ALM_PASSWORD=your-password

# Artifact Repository
ARTIFACT_REPO_URL=https://nexus.example.com
ARTIFACT_REPO_USERNAME=your-username
ARTIFACT_REPO_PASSWORD=your-password

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-password
DEFAULT_FROM_EMAIL=noreply@nev-test-platform.com
